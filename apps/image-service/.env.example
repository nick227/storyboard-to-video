IMAGE_SERVICE_PORT=8004
# Must match IMAGE_SERVICE_TOKEN in apps/web/.env — this is the server, that one is the client.
# If unset, the service stays usable for local dev (warns once at startup) but every real
# deploy (including Modal) must set this via a secret.
IMAGE_SERVICE_TOKEN=
IMAGE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# Optional local cache dir (Modal sets this to /root/models/sdxl-base).
# IMAGE_MODEL_DIR=
IMAGE_DEFAULT_STEPS=30
IMAGE_DEFAULT_GUIDANCE=5.0
